import random
class Pokemon:
    def __init__(self, name, hp, skill):
        self.name = name
        self.hp = hp
        self.max_hp = hp
        self.skill = skill
    def show_status(self):
        print(f"{self.name} hp:{self.hp}/{self.max_hp}")
    def is_alive(self):
        return self.hp > 0
    def attack(self, skill_index, other):
        skill_name = self.skill[skill_index][0]
        damage = self.skill[skill_index][1]
        print(f"\n {self.name} use {skill_name} damage to {other.name}!")
        other.hp -= damage
        print(f" {other.name} hp lost {damage}")

class Boss(Pokemon):
    def __init__(self, name, hp, skill, shield):
        super().__init__(name,hp,skill)
        self.shield = shield
        self.hp += shield
    def show_status(self):
        print(f"{self.name} hp:{self.hp}/{self.max_hp} | Shield: {self.shield}")

Arceus_skills = [["Power Blast",80],["Ultimate Force",120],["Trinity Nova", 200]]
